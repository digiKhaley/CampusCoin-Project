generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  income
  expense
}

enum AnnouncementType {
  announcement
  tip_template
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  isAdmin             Boolean   @default(false)
  isDisabled          Boolean   @default(false)
  academicYear        String?
  monthlyAllowance    Decimal?  @db.Decimal(10, 2)
  monthlySavingsGoal  Decimal?  @db.Decimal(10, 2)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())

  categories          Category[]
  transactions        Transaction[]
  budgets             Budget[]
  insights            Insight[]
  categoryCorrections CategoryCorrection[]
  tipStates           TipState[]
  savingsGoals        SavingsGoal[]
  splitExpenses       SplitExpense[]
}

// Admin-managed catalog copied into every NEW student's account at
// registration (SRS: default categories available to all students).
model DefaultCategory {
  id        String       @id @default(uuid())
  name      String
  type      CategoryType
  createdAt DateTime     @default(now())

  @@unique([name, type])
}

model Category {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
}

model Transaction {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category     @relation(fields: [categoryId], references: [id])
  amount              Decimal      @db.Decimal(10, 2)
  type                CategoryType
  description         String?
  aiSuggestedCategory String?
  date                DateTime
  isRecurring         Boolean      @default(false)
  nextOccurrence      DateTime?
  recurringSourceId   String?
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())

  @@index([userId, date])
  @@index([isRecurring, nextOccurrence])
}

// SRS: "edits and deletes transactions while retaining the full history".
model TransactionHistory {
  id            String   @id @default(uuid())
  transactionId String
  userId        String
  action        String
  snapshot      Json
  createdAt     DateTime @default(now())

  @@index([transactionId])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  month       DateTime
  limitAmount Decimal  @db.Decimal(10, 2)

  @@unique([userId, categoryId, month])
}

model Insight {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       DateTime
  summaryText String
  tipText     String
  pinned      Boolean  @default(false)
  note        String?
  generatedAt DateTime @default(now())

  @@unique([userId, month])
}

// Lets the categorizer learn from a student's overrides (SRS 1.6).
model CategoryCorrection {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword    String
  categoryId String
  createdAt  DateTime @default(now())

  @@unique([userId, keyword])
}

// Pin / dismiss / note state for a computed saving tip (tips themselves
// are computed on the fly).
model TipState {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  month      DateTime
  pinned     Boolean  @default(false)
  dismissed  Boolean  @default(false)
  note       String?

  @@unique([userId, categoryId, month])
}

// Frontend "Savings jars" screen.
model SavingsGoal {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Decimal  @db.Decimal(10, 2)
  savedAmount  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
}

// Frontend "Split expenses" screen.
model SplitExpense {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  totalAmount  Decimal  @db.Decimal(10, 2)
  myShare      Decimal  @db.Decimal(10, 2)
  splitCount   Int
  paidByMe     Boolean  @default(true)
  settled      Boolean  @default(false)
  participants String[]
  createdAt    DateTime @default(now())
}

// Admin panel: announcements and tip templates.
model Announcement {
  id        String           @id @default(uuid())
  type      AnnouncementType @default(announcement)
  title     String
  body      String
  createdAt DateTime         @default(now())
}

// Admin panel: activity log.
model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
